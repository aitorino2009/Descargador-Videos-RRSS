{
  "name": "video-downloader",
  "version": "2.0.0",
  "description": "Descargador de videos universal con interfaz web",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --out-path dist"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "bin/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
